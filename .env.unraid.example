# Copy this file to .env.unraid and change what you need.
# Kopieer dit bestand naar .env.unraid en pas aan wat je nodig hebt.
#
# Everything below is optional: on the first start MealieShopper guides you through security and
# the links with Mealie and Albert Heijn itself.
# Alles hieronder is optioneel: bij de eerste start loopt MealieShopper je zelf door de
# beveiliging en de koppelingen met Mealie en Albert Heijn.
#
# The Docker Compose file maps host port 5959 to container port 8000 and mounts:
# /mnt/user/appdata/mealieshopper:/data
# De Docker Compose-file zet hostpoort 5959 op containerpoort 8000 en mount dezelfde map.

# --- Secret ----------------------------------------------------------------------------------
# You do not need to set this. Without it the app creates a random secret on the first start and
# keeps it in the data folder (secret.key). It encrypts your stored links (Mealie token, AH token)
# and signs your sessions. Include the whole data folder, secret.key too, in your backups: without
# that file the stored links and sessions cannot be read, and you link Mealie and Albert Heijn again.
# Set a value yourself if you want the key to live outside the data folder (for example in a secret
# manager): a long, fixed, random value, e.g. `openssl rand -hex 32`. Then the key is not on disk
# next to the database. Do not change it afterwards: you would have to link everything again.
#
# Je hoeft dit niet in te stellen. Zonder deze waarde maakt de app bij de eerste start zelf een
# willekeurig geheim en bewaart dat in de data-map (secret.key). Het versleutelt je opgeslagen
# koppelingen (Mealie-token, AH-token) en ondertekent je sessies. Neem de hele data-map, ook
# secret.key, mee in je back-ups: zonder dat bestand zijn de opgeslagen koppelingen en sessies
# onleesbaar en koppel je Mealie en Albert Heijn opnieuw.
# Stel zelf een waarde in als de sleutel buiten de data-map moet staan (bijvoorbeeld in een
# secret manager): een lange, vaste, willekeurige waarde, bijvoorbeeld `openssl rand -hex 32`.
# De sleutel staat dan niet op schijf naast de database. Verander hem niet achteraf: dan moet
# je alles opnieuw koppelen.
# MEALIESHOPPER_AUTH_SECRET=

# The public address, used for the preview image when you share the link.
# Het publieke adres, voor de voorbeeldafbeelding als je de link deelt.
MEALIESHOPPER_PUBLIC_BASE_URL=https://mealieshopper.example.com

# --- Only with your own domain name and HTTPS (for passkeys) ---------------------------------
# Without a domain name (for example http://192.168.1.20:5959) you can log in with a username and
# password; passkeys do not work there.
# RP_ID is the host name only, without scheme or port. RP_ORIGINS is the full address in the
# browser, comma-separated if you use more than one.
#
# Alleen met een eigen domeinnaam en HTTPS (voor passkeys).
# Zonder domeinnaam (bijvoorbeeld http://192.168.1.20:5959) kun je inloggen met een gebruikersnaam
# en wachtwoord; passkeys werken daar niet.
# RP_ID is alleen de hostnaam, zonder schema of poort. RP_ORIGINS is het volledige adres in de
# browser, kommagescheiden bij meerdere adressen.
# RP_NAME=MealieShopper
# RP_ID=mealieshopper.example.com
# RP_ORIGINS=https://mealieshopper.example.com

# --- Behind a reverse proxy ------------------------------------------------------------------
# MealieShopper trusts the X-Forwarded-For/-Proto/-Host headers of one proxy. Do not expose it
# directly to the internet: anyone who sends X-Forwarded-For themselves bypasses the block per IP
# address after failed login attempts.
#
# Achter een reverse proxy: MealieShopper vertrouwt de headers X-Forwarded-For/-Proto/-Host van
# één proxy. Zet hem dus niet rechtstreeks op internet: wie dan zelf X-Forwarded-For meestuurt,
# omzeilt de blokkade per IP-adres na mislukte inlogpogingen.

# --- Turn login off (emergency only) ---------------------------------------------------------
# With false anyone who knows the address can use everything. You normally set up a password,
# two-step verification and passkeys in the app (Settings > Security).
#
# Inloggen uitzetten (alleen als noodgreep): met false kan iedereen die het adres kent alles
# gebruiken. Wachtwoord, tweestapsverificatie en passkeys stel je normaal in via de app
# (Beheer > Beveiliging).
# PASSKEY_AUTH_ENABLED=false

# --- Optional: links through the environment -------------------------------------------------
# You can simply link Mealie in the app (Settings > Mealie). A link made in the app takes
# precedence over these two values. Use an address the container can reach.
#
# Optioneel: koppelingen via de omgeving. Mealie koppel je gewoon in de app (Beheer > Mealie).
# Een koppeling uit de app gaat voor op deze twee waarden. Gebruik een adres dat de container
# kan bereiken.
# MEALIE_URL=https://mealie.example.com
# MEALIE_API_TOKEN=

# Albert Heijn: log in under Settings > Albert Heijn; the token is stored encrypted.
# Albert Heijn: log in via Beheer > Albert Heijn; de token wordt versleuteld bewaard.
# AH_REFRESH_TOKEN=

# --- AI assistants (MCP) -------------------------------------------------------------------------
# MealieShopper has an MCP server at <address>/mcp, so Claude, ChatGPT or Copilot can look at your
# week menu, recipes and lists and import a recipe into Mealie. It logs in with OAuth (each user with
# their own account) and only works when login is on. ChatGPT and claude.ai need to reach it from the
# internet over HTTPS, so set MEALIESHOPPER_PUBLIC_BASE_URL to that public address. Turn it off: false.
#
# AI-assistenten (MCP): MealieShopper heeft een MCP-server op <adres>/mcp, zodat Claude, ChatGPT of
# Copilot je weekmenu, recepten en lijstjes kunnen bekijken en een recept in Mealie kunnen importeren.
# Inloggen gaat met OAuth (elke gebruiker met het eigen account) en werkt alleen als inloggen aanstaat.
# ChatGPT en claude.ai moeten er via internet met HTTPS bij kunnen: zet MEALIESHOPPER_PUBLIC_BASE_URL
# op dat publieke adres. Uitzetten: false.
# MEALIESHOPPER_MCP=false
