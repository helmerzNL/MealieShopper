# Kopieer dit bestand naar .env.unraid en pas aan wat je nodig hebt.
# Alles hieronder is optioneel: bij de eerste start loopt MealieShopper je zelf door de
# beveiliging en de koppelingen met Mealie en Albert Heijn.
#
# De Docker Compose-file zet hostpoort 5959 op containerpoort 8000 en mount:
# /mnt/user/appdata/mealieshopper:/data

# Sterk aanbevolen: een lange, vaste, willekeurige waarde, bijvoorbeeld: openssl rand -hex 32
# Hij versleutelt je opgeslagen koppelingen (Mealie-token, AH-token) en ondertekent je sessies.
# Verander hem niet achteraf: dan moet je alles opnieuw koppelen en log je overal uit.
# Zonder deze waarde maakt de app zelf een sessiesleutel in de data-map (session.key), maar de
# opgeslagen koppelingen worden dan met een zwakkere sleutel versleuteld.
MEALIESHOPPER_AUTH_SECRET=

# Het publieke adres, voor de voorbeeldafbeelding als je de link deelt.
MEALIESHOPPER_PUBLIC_BASE_URL=https://mealieshopper.example.com

# --- Alleen met een eigen domeinnaam en HTTPS (voor passkeys) -------------------------------
# Zonder domeinnaam (bijvoorbeeld http://192.168.1.20:5959) kun je inloggen met een
# gebruikersnaam en wachtwoord; passkeys werken daar niet.
# RP_ID is alleen de hostnaam, zonder schema of poort. RP_ORIGINS is het volledige adres in
# de browser, kommagescheiden bij meerdere adressen.
# RP_NAME=MealieShopper
# RP_ID=mealieshopper.example.com
# RP_ORIGINS=https://mealieshopper.example.com

# --- Achter een reverse proxy ----------------------------------------------------------------
# MealieShopper vertrouwt de headers X-Forwarded-For/-Proto/-Host van één proxy. Zet hem dus
# niet rechtstreeks op internet: wie dan zelf X-Forwarded-For meestuurt, omzeilt de blokkade
# per IP-adres na mislukte inlogpogingen.

# --- Inloggen uitzetten (alleen als noodgreep) ------------------------------------------------
# Met false kan iedereen die het adres kent alles gebruiken. Wachtwoord, tweestapsverificatie
# en passkeys stel je normaal in via de app (Beheer > Beveiliging).
# PASSKEY_AUTH_ENABLED=false

# --- Optioneel: koppelingen via de omgeving ----------------------------------------------------
# Mealie koppel je gewoon in de app (Beheer > Mealie). Een koppeling uit de app gaat voor
# op deze twee waarden. Gebruik een adres dat de container kan bereiken.
# Houd MEALIESHOPPER_AUTH_SECRET ingesteld voordat je MEALIE_URL weghaalt of wijzigt.
# MEALIE_URL=https://mealie.example.com
# MEALIE_API_TOKEN=

# Albert Heijn: log in via Beheer > Albert Heijn; de token wordt versleuteld bewaard.
# AH_REFRESH_TOKEN=
