# Copy this file to .env next to docker-compose.yml. Docker Compose reads .env itself (the
# app settings live in .env.unraid, see .env.unraid.example).
# Kopieer dit bestand naar .env naast docker-compose.yml. Docker Compose leest .env zelf (de
# instellingen van de app staan in .env.unraid, zie .env.unraid.example).

# Which build to install: latest (stable, the default) or beta (the development version, with a
# "beta" badge in the app). Use a separate data folder for beta. Pull with `docker compose pull`.
# Welke build je installeert: latest (stabiel, de standaard) of beta (de ontwikkelversie, met een
# "beta"-badge in de app). Gebruik voor beta een aparte data-map. Ophalen met `docker compose pull`.
MEALIESHOPPER_TAG=latest
