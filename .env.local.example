# Running locally (python run.py). Everything below is optional: on the first start MealieShopper
# guides you through security and the links with Mealie and Albert Heijn itself.
# Lokaal draaien (python run.py). Alles hieronder is optioneel: bij de eerste start loopt
# MealieShopper je zelf door de beveiliging en de koppelingen met Mealie en Albert Heijn.
#
# On http://localhost:8000 you can log in with a username and password. Passkeys need a domain
# name with HTTPS; see .env.unraid.example.
# Op http://localhost:8000 kun je inloggen met een gebruikersnaam en wachtwoord. Passkeys vragen
# een domeinnaam met HTTPS; zie .env.unraid.example.

# Optional. Without it the app creates a random secret in the data folder (secret.key) on the
# first start; keep that file in your backups. Set a long, fixed, random value (`openssl rand -hex
# 32`) if you want the key outside the data folder. Do not change it afterwards.
# Optioneel. Zonder deze waarde maakt de app bij de eerste start zelf een willekeurig geheim in
# de data-map (secret.key); neem dat bestand mee in je back-ups. Stel een lange, vaste,
# willekeurige waarde in (`openssl rand -hex 32`) als de sleutel buiten de data-map moet staan.
# Verander hem niet achteraf.
# MEALIESHOPPER_AUTH_SECRET=
MEALIESHOPPER_DATA_DIR=./data
MEALIESHOPPER_PUBLIC_BASE_URL=http://localhost:8000

# Optional: you can also link Mealie in the app (Settings > Mealie). A link from the app wins.
# Optioneel: Mealie koppel je ook in de app (Beheer > Mealie). Een koppeling uit de app gaat voor.
# MEALIE_URL=https://mealie.example.com
# MEALIE_API_TOKEN=

# Optional: link Albert Heijn under Settings > Stores > Albert Heijn.
# Optioneel: Albert Heijn koppel je via Beheer > Winkels > Albert Heijn.
# AH_REFRESH_TOKEN=

# Optional: link Picnic under Settings > Stores > Picnic. Country of the Picnic account: NL (default), DE or FR.
# Optioneel: Picnic koppel je via Beheer > Winkels > Picnic. Land van het Picnic-account: NL (standaard), DE of FR.
# PICNIC_COUNTRY_CODE=NL

# Turn login off (emergency only): false.
# Inloggen uitzetten (alleen als noodgreep): false.
# PASSKEY_AUTH_ENABLED=false

# --- AI assistants (MCP) -------------------------------------------------------------------------
# MealieShopper has an MCP server at <address>/mcp, so Claude, ChatGPT or Copilot can look at your
# week menu, recipes and lists and import a recipe into Mealie. It logs in with OAuth (each user with
# their own account) and only works when login is on. You normally set this in the app, by the
# administrator under Settings > AI apps: a switch for the server and the public address (detected
# automatically). Those settings take precedence over the two values below, which only give the
# starting point. ChatGPT and claude.ai need to reach the server from the internet over HTTPS.
#
# AI-assistenten (MCP): MealieShopper heeft een MCP-server op <adres>/mcp, zodat Claude, ChatGPT of
# Copilot je weekmenu, recepten en lijstjes kunnen bekijken en een recept in Mealie kunnen importeren.
# Inloggen gaat met OAuth (elke gebruiker met het eigen account) en werkt alleen als inloggen aanstaat.
# Je stelt dit meestal in de app in, door de beheerder bij Beheer > AI-apps: een schakelaar voor de
# server en het publieke adres (wordt automatisch herkend). Die instellingen gaan voor op de twee
# waarden hieronder, die alleen het beginpunt geven. ChatGPT en claude.ai moeten er via internet met
# HTTPS bij kunnen.
# MEALIESHOPPER_MCP=false

# Updatecheck: de app kijkt op GitHub of er een nieuwere release is en meldt dat aan de beheerder
# (Beheer > Updates). Er gaat geen informatie over jou of de installatie mee. Zet uit met false.
# MEALIESHOPPER_UPDATE_CHECK=false

# Auditlog (Beheer > Auditlog): het verkeer met Albert Heijn, Picnic en Jumbo en de verzoeken van
# AI-assistenten (MCP). Wachtwoorden, tokens en codes worden nooit bewaard. Standaard aan.
# Audit log (Settings > Audit log): the traffic with Albert Heijn, Picnic and Jumbo and the requests
# from AI assistants (MCP). Passwords, tokens and codes are never stored. On by default.
# MEALIESHOPPER_AUDIT_LOG=false
# Alleen wie/wat/wanneer bewaren, niet de verzoeken en antwoorden zelf. / Store only who/what/when, not the requests and answers.
# MEALIESHOPPER_AUDIT_BODIES=false
# Aantal tekens per verzoek of antwoord (standaard 4000). / Characters per request or answer (default 4000).
# MEALIESHOPPER_AUDIT_BODY_CHARS=4000
# Na hoeveel dagen regels worden gewist (standaard 30, 0 = nooit). / Days before entries are deleted (default 30, 0 = never).
# MEALIESHOPPER_AUDIT_RETENTION_DAYS=30
